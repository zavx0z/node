{
  "name": "@nodes/workspace",
  "version": "0.1.0",
  "description": "High-performance node systems, authoring, layout, workers, WebGPU views and static Storybook. Built for MetaFor.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavx0z/node.git"
  },
  "homepage": "https://zavx0z.github.io/node/",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "metafor": "https://github.com/zavx0z/metafor",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test packages tests",
    "check": "bun run typecheck && bun run test && bun run --cwd packages/storybook build"
  },
  "devDependencies": {
    "@engine/core": "link:@engine/core",
    "@layout/core": "link:@layout/core",
    "@nodes/core": "workspace:*",
    "@nodes/editor": "workspace:*",
    "@nodes/layout": "workspace:*",
    "@nodes/storybook": "workspace:*",
    "@nodes/ui": "workspace:*",
    "@nodes/worker": "workspace:*",
    "@types/bun": "^1.4.0",
    "@ui/components": "link:@ui/components",
    "@ui/elements": "link:@ui/elements",
    "@webgpu/types": "^0.1.68",
    "@zavx0z/highlighter": "link:@zavx0z/highlighter",
    "@zavx0z/storybook": "link:@zavx0z/storybook",
    "typescript": "^7.0.2"
  }
}
